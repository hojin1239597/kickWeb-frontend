{
	"name": "kick-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && npm run smui-theme",
		"smui-theme": "smui-theme compile static/smui.css -i src/theme",
